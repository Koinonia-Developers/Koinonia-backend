generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                    String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  full_name_three_parts String       @db.VarChar(150)
  email                 String       @unique(map: "idx_users_email") @db.VarChar(100)
  password_hash         String       @db.VarChar(255)
  university_id         String?      @unique @db.VarChar(50)
  academic_dept         String?      @db.VarChar(100)
  academic_year         Int?
  dorm_block            String?      @db.VarChar(20)
  dorm_room             String?      @db.VarChar(20)
  phone_number          String?      @db.VarChar(20)
  profile_image_url     String?      @default("/assets/avatar.png") @db.VarChar(255)
  bio                   String?
  sex                   Sex?
  clerical_rank         ClericalRank @default(NONE)
  system_role           system_role  @default(USER)
  service_class_id      String?      @db.Uuid
  pending_class_id      String?      @db.Uuid
  repentance_father_id  String?      @db.Uuid
  repentance_deacon_id  String?      @db.Uuid
  spiritual_father_id   String?      @db.Uuid
  spiritual_mother_id   String?      @db.Uuid
  created_at            DateTime     @default(now()) @db.Timestamptz(6)
  updated_at            DateTime     @default(now()) @db.Timestamptz(6)
  created_by            String?      @db.Uuid
  updated_by            String?      @db.Uuid

  // Member Affairs fields
  verification_status String?   @default("PENDING_REVIEW") @db.VarChar(20)
  preferred_class_id  String?   @db.Uuid
  rejection_reason    String?   @db.Text
  approved_at         DateTime? @db.Timestamptz(6)
  approved_by         String?   @db.Uuid
  is_active           Boolean   @default(true)

  // Education: phases the member has graduated from
  graduated_phases Json? @default("[]")

  // Relations
  preferred_class ServiceClass? @relation("UserPreferredClass", fields: [preferred_class_id], references: [id])
  approver        User?         @relation("UserApprover", fields: [approved_by], references: [id])
  approved_users  User[]        @relation("UserApprover")

  // Document approval workflow relations
  uploaded_documents DepartmentDocument[] @relation("DocumentUploader")
  approved_documents DepartmentDocument[] @relation("DocumentApprover")
  document_comments  DocumentComment[]
  document_reactions DocumentReaction[]

  member_audit_logs    MembershipAuditLog[] @relation("auditLogMember")
  performer_audit_logs MembershipAuditLog[] @relation("auditLogPerformer")
  sub_class_members    SubClassMember[]

  // Existing relations (unchanged)
  announcements                                           Announcement[]
  comments                                                Comment[]
  course_submissions_course_submissions_created_byTousers course_submissions[] @relation("course_submissions_created_byTousers")
  course_submissions_course_submissions_teacher_idTousers course_submissions[] @relation("course_submissions_teacher_idTousers")
  lms_enrollments                                         lms_enrollments[]
  notifications                                           Notification[]
  reactions                                               reactions[]
  sub_classes_sub_classes_sub_chair_idTousers             sub_classes[]        @relation("sub_classes_sub_chair_idTousers")
  sub_classes_sub_classes_sub_secretary_idTousers         sub_classes[]        @relation("sub_classes_sub_secretary_idTousers")
  sub_classes_sub_classes_sub_vice_idTousers              sub_classes[]        @relation("sub_classes_sub_vice_idTousers")
  users_users_created_byTousers                           User?                @relation("users_created_byTousers", fields: [created_by], references: [id], onUpdate: NoAction)
  other_users_users_created_byTousers                     User[]               @relation("users_created_byTousers")
  users_users_repentance_deacon_idTousers                 User?                @relation("users_repentance_deacon_idTousers", fields: [repentance_deacon_id], references: [id], onUpdate: NoAction)
  other_users_users_repentance_deacon_idTousers           User[]               @relation("users_repentance_deacon_idTousers")
  users_users_repentance_father_idTousers                 User?                @relation("users_repentance_father_idTousers", fields: [repentance_father_id], references: [id], onUpdate: NoAction)
  other_users_users_repentance_father_idTousers           User[]               @relation("users_repentance_father_idTousers")
  service_classes                                         ServiceClass?        @relation(fields: [service_class_id], references: [id], onUpdate: NoAction)
  users_users_spiritual_father_idTousers                  User?                @relation("users_spiritual_father_idTousers", fields: [spiritual_father_id], references: [id], onUpdate: NoAction)
  other_users_users_spiritual_father_idTousers            User[]               @relation("users_spiritual_father_idTousers")
  users_users_spiritual_mother_idTousers                  User?                @relation("users_spiritual_mother_idTousers", fields: [spiritual_mother_id], references: [id], onUpdate: NoAction)
  other_users_users_spiritual_mother_idTousers            User[]               @relation("users_spiritual_mother_idTousers")
  users_users_updated_byTousers                           User?                @relation("users_updated_byTousers", fields: [updated_by], references: [id], onUpdate: NoAction)
  other_users_users_updated_byTousers                     User[]               @relation("users_updated_byTousers")

  // Sub-class approval requests
  approval_requests_initiated SubClassApprovalRequest[] @relation("SubClassApprovalRequestedBy")
  approval_requests_approved  SubClassApprovalRequest[] @relation("SubClassApprovalApprovedBy")
 announcements_approved Announcement[] @relation("AnnouncementApprovedBy")

  @@index([created_at], map: "idx_users_created_at")
  @@index([repentance_father_id], map: "idx_users_repentance_father_id")
  @@index([service_class_id], map: "idx_users_service_class_id")
  @@index([system_role], map: "idx_users_system_role")
  @@index([university_id], map: "idx_users_university_id")
  @@index([verification_status])
  @@index([preferred_class_id])
  @@map("users")
}

model ServiceClass {
  id                     String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  class_name_amharic     String               @unique @db.VarChar(100)
  is_public_registration Boolean              @default(true)
  created_at             DateTime             @default(now()) @db.Timestamptz(6)
  updated_at             DateTime             @default(now()) @db.Timestamptz(6)
  announcements          Announcement[]
  sub_classes            sub_classes[]
  users                  User[]
  preferred_users        User[]               @relation("UserPreferredClass")
  department_documents   DepartmentDocument[]

  @@map("service_classes")
}

enum AnnouncementStatus {
  PENDING
  APPROVED
  REJECTED
  DRAFT
}
model Announcement {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title           String        @db.VarChar(200)
  content         String
  is_public       Boolean       @default(true)
  target_class_id String?       @db.Uuid
  author_id       String        @db.Uuid
  published_at    DateTime      @default(now()) @db.Timestamptz(6)
  updated_at      DateTime      @default(now()) @db.Timestamptz(6)
  image_url       String?       @db.Text
  video_url       String?       @db.Text
  pdf_url         String?       @db.Text

  // ✅ Approval workflow fields
  status           AnnouncementStatus @default(APPROVED)
  rejection_reason String?            @db.Text
  approved_by_id   String?            @db.Uuid
  submitted_at     DateTime?          @db.Timestamptz(6)

  // Relations
  users           User          @relation(fields: [author_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  service_classes ServiceClass? @relation(fields: [target_class_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  comments        Comment[]
  reactions       reactions[]
  approved_by     User?         @relation("AnnouncementApprovedBy", fields: [approved_by_id], references: [id])

  @@index([is_public, published_at], map: "idx_announcements_is_public_published_at")
  @@index([target_class_id], map: "idx_announcements_target_class_id")
  @@index([status], map: "idx_announcements_status")
  @@map("announcements")
}

model Comment {
  id                String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  announcement_id   String       @db.Uuid
  parent_comment_id String?      @db.Uuid
  author_id         String       @db.Uuid
  content           String
  created_at        DateTime     @default(now()) @db.Timestamptz(6)
  announcements     Announcement @relation(fields: [announcement_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users             User         @relation(fields: [author_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  comments          Comment?     @relation("commentsTocomments", fields: [parent_comment_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  other_comments    Comment[]    @relation("commentsTocomments")

  @@index([announcement_id], map: "idx_comments_announcement_id")
  @@map("comments")
}

model Notification {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id           String    @db.Uuid
  title             String    @db.VarChar(200)
  message           String?
  target_route      String?   @db.VarChar(200)
  is_read           Boolean   @default(false)
  type              String?   @db.VarChar(50)
  related_entity_id String?   @db.Uuid
  deleted_at        DateTime? @db.Timestamptz(6)
  created_at        DateTime  @default(now()) @db.Timestamptz(6)
  users             User      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id, is_read, created_at], map: "idx_notifications_user_id_is_read_created_at")
  @@index([user_id, is_read], map: "idx_notifications_unread")
  @@map("notifications")
}

/// This table is a partition table and requires additional setup for migrations. Visit https://pris.ly/d/partition-tables for more info.
/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model audit_logs {
  id          String?  @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String?  @db.Uuid
  action      String   @db.VarChar(50)
  entity_type String   @db.VarChar(50)
  entity_id   String?  @db.Uuid
  old_state   Json?
  new_state   Json?
  ip_address  String?  @db.Inet
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  @@index([created_at], map: "idx_audit_logs_created_at")
  @@index([entity_type, entity_id], map: "idx_audit_logs_entity")
  @@ignore
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model course_submissions {
  id                                         String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teacher_id                                 String            @db.Uuid
  batch_id                                   String            @db.Uuid
  title                                      String            @db.VarChar(200)
  content_package                            String
  status                                     submission_status @default(DRAFT)
  review_feedback                            String?
  implemented_page_url                       String?           @db.VarChar(500)
  submitted_at                               DateTime?         @db.Timestamptz(6)
  reviewed_at                                DateTime?         @db.Timestamptz(6)
  implemented_at                             DateTime?         @db.Timestamptz(6)
  published_at                               DateTime?         @db.Timestamptz(6)
  created_by                                 String?           @db.Uuid
  created_at                                 DateTime          @default(now()) @db.Timestamptz(6)
  updated_at                                 DateTime          @default(now()) @db.Timestamptz(6)
  lms_batches                                lms_batches       @relation(fields: [batch_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users_course_submissions_created_byTousers User?             @relation("course_submissions_created_byTousers", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_course_submissions_teacher_idTousers User              @relation("course_submissions_teacher_idTousers", fields: [teacher_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([batch_id, status], map: "idx_course_submissions_batch_id_status")
  @@index([teacher_id], map: "idx_course_submissions_teacher_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model library_items {
  id                  String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title               String           @db.VarChar(200)
  description         String?
  drive_url           String           @db.VarChar(500)
  drive_file_id       String?          @db.VarChar(100)
  preview_url         String?          @db.VarChar(500)
  category            library_category
  academic_department String?          @db.VarChar(100)
  academic_year       Int?
  course_id           String?          @db.VarChar(50)
  document_type       document_type?
  likes               Int              @default(0)
  downloads           Int              @default(0)
  is_link_broken      Boolean          @default(false)
  last_checked_at     DateTime?        @db.Timestamptz(6)
  created_at          DateTime         @default(now()) @db.Timestamptz(6)
  updated_at          DateTime         @default(now()) @db.Timestamptz(6)

  @@index([academic_department], map: "idx_library_items_academic_department")
  @@index([category], map: "idx_library_items_category")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model lms_batches {
  id                 String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  course_track       course_track
  batch_number       Int
  status             batch_status         @default(ACTIVE)
  academic_year      Int
  created_at         DateTime             @default(now()) @db.Timestamptz(6)
  updated_at         DateTime             @default(now()) @db.Timestamptz(6)
  course_submissions course_submissions[]
  lms_enrollments    lms_enrollments[]
  subjects           Subject[]
  exams              Exam[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model lms_enrollments {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id           String           @db.Uuid
  batch_id          String           @db.Uuid
  completed_lessons Json             @default("[]")
  quiz_scores       Json             @default("{}")
  final_exam_score  Decimal?         @db.Decimal(5, 2)
  is_passed         Boolean          @default(false)
  certificate_hash  String?          @unique @db.VarChar(255)
  enrolled_at       DateTime         @default(now()) @db.Timestamptz(6)
  updated_at        DateTime         @default(now()) @db.Timestamptz(6)
  status            EnrollmentStatus @default(PENDING)

  lms_batches lms_batches @relation(fields: [batch_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users       User        @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, batch_id])
  @@index([batch_id], map: "idx_lms_enrollments_batch_id")
  @@index([is_passed], map: "idx_lms_enrollments_is_passed")
  @@index([user_id], map: "idx_lms_enrollments_user_id")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model reactions {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  announcement_id String        @db.Uuid
  user_id         String        @db.Uuid
  reaction_type   reaction_type
  created_at      DateTime      @default(now()) @db.Timestamptz(6)
  announcements   Announcement  @relation(fields: [announcement_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users           User          @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([announcement_id, user_id])
  @@index([announcement_id, user_id], map: "idx_reactions_announcement_id_user_id")
}

model SubClassMember {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sub_class_id String   @db.Uuid
  user_id      String   @db.Uuid
  assigned_at  DateTime @default(now()) @db.Timestamptz(6)

  sub_class sub_classes @relation(fields: [sub_class_id], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([sub_class_id, user_id])
  @@map("sub_class_members")
}

model DepartmentDocument {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  service_class_id String   @db.Uuid
  document_type    String   @db.VarChar(20)
  title            String?  @db.VarChar(200)
  description      String?
  drive_url        String   @db.VarChar(500)
  academic_year    Int?
  quarter          Int?
  uploaded_by      String?  @db.Uuid
  created_at       DateTime @default(now()) @db.Timestamptz(6)
  updated_at       DateTime @default(now()) @db.Timestamptz(6)

  status           DocumentStatus @default(PENDING)
  approved_by      String?        @db.Uuid
  approved_at      DateTime?      @db.Timestamptz(6)
  rejection_reason String?        @db.Text

  service_class ServiceClass       @relation(fields: [service_class_id], references: [id], onDelete: Cascade)
  uploader      User?              @relation("DocumentUploader", fields: [uploaded_by], references: [id])
  approver      User?              @relation("DocumentApprover", fields: [approved_by], references: [id])
  comments      DocumentComment[]
  reactions     DocumentReaction[]

  @@index([service_class_id, document_type])
  @@index([status])
  @@map("department_documents")
}

// Add status enum for documents
enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

// Add comment model for documents
model DocumentComment {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  document_id String   @db.Uuid
  user_id     String   @db.Uuid
  content     String
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @default(now()) @db.Timestamptz(6)
  parent_id   String?  @db.Uuid // for nested comments (optional)

  document DepartmentDocument @relation(fields: [document_id], references: [id], onDelete: Cascade)
  user     User               @relation(fields: [user_id], references: [id], onDelete: Cascade)
  parent   DocumentComment?   @relation("DocumentCommentToParent", fields: [parent_id], references: [id])
  replies  DocumentComment[]  @relation("DocumentCommentToParent")

  @@index([document_id, created_at])
  @@map("document_comments")
}

// Add reaction model for documents
model DocumentReaction {
  id            String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  document_id   String                 @db.Uuid
  user_id       String                 @db.Uuid
  reaction_type document_reaction_type
  created_at    DateTime               @default(now()) @db.Timestamptz(6)

  document DepartmentDocument @relation(fields: [document_id], references: [id], onDelete: Cascade)
  user     User               @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([document_id, user_id])
  @@index([document_id])
  @@map("document_reactions")
}

enum document_reaction_type {
  LIKE
  STAR
}

model MembershipAuditLog {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  member_id    String   @db.Uuid
  action       String   @db.VarChar(50)
  old_value    Json?
  new_value    Json?
  performed_by String?  @db.Uuid
  created_at   DateTime @default(now()) @db.Timestamptz(6)

  member    User  @relation("auditLogMember", fields: [member_id], references: [id], onDelete: Cascade)
  performer User? @relation("auditLogPerformer", fields: [performed_by], references: [id])

  @@index([member_id])
  @@index([created_at])
  @@map("membership_audit_logs")
}

model sub_classes {
  id                                        String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  parent_class_id                           String                    @db.Uuid
  sub_class_name                            String                    @db.VarChar(100)
  sub_chair_id                              String?                   @db.Uuid
  sub_vice_id                               String?                   @db.Uuid
  sub_secretary_id                          String?                   @db.Uuid
  status                                    sub_class_status          @default(PENDING_APPROVAL)
  created_at                                DateTime                  @default(now()) @db.Timestamptz(6)
  updated_at                                DateTime                  @default(now()) @db.Timestamptz(6)
  service_classes                           ServiceClass              @relation(fields: [parent_class_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users_sub_classes_sub_chair_idTousers     User?                     @relation("sub_classes_sub_chair_idTousers", fields: [sub_chair_id], references: [id], onUpdate: NoAction)
  users_sub_classes_sub_secretary_idTousers User?                     @relation("sub_classes_sub_secretary_idTousers", fields: [sub_secretary_id], references: [id], onUpdate: NoAction)
  users_sub_classes_sub_vice_idTousers      User?                     @relation("sub_classes_sub_vice_idTousers", fields: [sub_vice_id], references: [id], onUpdate: NoAction)
  members                                   SubClassMember[]
  approval_requests                         SubClassApprovalRequest[]
}

enum sub_class_status {
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

enum batch_status {
  ACTIVE
  GRADUATED
}

enum course_track {
  GUBAE_ABEW
  GUBAE_HAWARYAT
  GUBAE_ECCLESIAE
}

enum document_type {
  TEXTBOOK
  PAST_EXAM
}

enum library_category {
  SPIRITUAL
  ACADEMIC
  OTHER
}

enum reaction_type {
  LIKE
  STAR
}

enum submission_status {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  IMPLEMENTATION_IN_PROGRESS
  PUBLISHED
}

enum Sex {
  MALE
  FEMALE
}

enum ClericalRank {
  NONE
  DEACON
  PRIEST
  LECTOR
  OTHER
}

enum system_role {
  USER
  MEMBER
  TEACHER
  CLASS_LEADER
  SERVICE_MANAGER
  SECRETARIAT_SECRETARY
  SECRETARIAT_VICE
  SECRETARIAT_CHAIRMAN
}

enum EnrollmentStatus {
  PENDING
  ACTIVE
  REJECTED
  GRADUATED
}

// New Education tables

model Subject {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  batchId     String   @db.Uuid
  title       String
  description String?
  order       Int
  lessons     Lesson[]
  exam        Exam?

  batch lms_batches @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@map("subjects")
}

model Lesson {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  subjectId String   @db.Uuid
  title     String
  content   String // HTML
  order     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@map("lessons")
}

model InlineExplanation {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lessonId    String // no @db.Uuid, no relation
  quotedText  String
  explanation String
  createdAt   DateTime @default(now())

  @@map("inline_explanations") // ← ADD THIS LINE
}

model Exam {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  subjectId    String?  @unique @db.Uuid // each subject has at most one exam
  batchId      String   @db.Uuid
  title        String
  description  String?
  questions    Json
  passingScore Float    @default(75)
  isExitExam   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  subject Subject?    @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  batch   lms_batches @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@map("exams")
}

// Sub-Class Approval Request tracking
model SubClassApprovalRequest {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sub_class_id     String    @db.Uuid
  request_type     String    @db.VarChar(50) // 'CREATE' | 'ADD_LEADER' | 'UPDATE'
  requested_by_id  String    @db.Uuid
  requested_at     DateTime  @default(now()) @db.Timestamptz(6)
  status           String    @default("PENDING") @db.VarChar(20) // 'PENDING' | 'APPROVED' | 'REJECTED'
  approved_by_id   String?   @db.Uuid
  approved_at      DateTime? @db.Timestamptz(6)
  rejection_reason String?
  request_data     Json // stores the requested changes
  created_at       DateTime  @default(now()) @db.Timestamptz(6)
  updated_at       DateTime  @default(now()) @db.Timestamptz(6)

  requested_by User        @relation("SubClassApprovalRequestedBy", fields: [requested_by_id], references: [id], onDelete: Cascade)
  approved_by  User?       @relation("SubClassApprovalApprovedBy", fields: [approved_by_id], references: [id], onDelete: SetNull)
  sub_classes  sub_classes @relation(fields: [sub_class_id], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([sub_class_id])
  @@index([requested_by_id])
  @@map("sub_class_approval_requests")
}
